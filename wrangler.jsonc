{
  // Cloudflare Worker that serves the site (public/) and the leaderboard API (src/worker.js).
  // See SETUP.md for the one-time setup steps.
  "name": "travel-globe",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "travel-globe",
      // D1 database ID (dashboard: Storage & Databases → D1 → travel-globe). Not a secret.
      "database_id": "cbb4f712-22d1-41a3-8028-0333367ff239"
    }
  ],
  // Your subdomain. Must be on a domain that's in this Cloudflare account.
  "routes": [{ "pattern": "travel-globe.shneor.dev", "custom_domain": true }],
  "vars": {
    // Turnstile *site* key (public). The SECRET key goes only in the dashboard: Worker → Settings → Variables and Secrets → TURNSTILE_SECRET.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGSn2j8XEoWoMaqr"
  },
  "observability": { "enabled": true }
}
